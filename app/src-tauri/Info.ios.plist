<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the iOS app's Info.plist (design-docs/ios-app.md): the app's
     Documents folder shows up in Files › On My iPhone › plan-up, which is where
     Export writes. -->
<plist version="1.0">
<dict>
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <!-- iOS 27 stops apps that don't adopt the UIScene lifecycle at launch
       (UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption). tao ≥ 0.37
       (tauri 2.12) ships TaoSceneDelegate; declaring the manifest puts the app
       on scenes. One window only. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
          <key>UISceneConfigurationName</key>
          <string>Default Configuration</string>
          <key>UISceneDelegateClassName</key>
          <string>TaoSceneDelegate</string>
        </dict>
      </array>
    </dict>
  </dict>
  <key>CFBundleDisplayName</key>
  <string>plan-up</string>
</dict>
</plist>
